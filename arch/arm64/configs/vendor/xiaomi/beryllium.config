# Platform
CONFIG_MACH_XIAOMI_E10=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS_MI=y
CONFIG_TOUCHSCREEN_NT36XXX_MI=y

# LEDS
CONFIG_LEDS_LM3644=y

# Identify the kernel in `uname -r`; the CI tree is patched in-place by
# KernelSU, so the git suffix alone would only ever say "-dirty".
CONFIG_LOCALVERSION="-beryllium"

# KernelSU-Next
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KSU=y
CONFIG_KSU_SYSCALL_TABLE_HOOK=y
# CONFIG_KSU_MANUAL_HOOK is not set
# CONFIG_KSU_KPROBES_HOOK is not set
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
